HOST=0.0.0.0
PORT=8007
CONTRACT_MIN_VERSION=1.0.0
AGENT_ID=tester-01
AGENT_ROLE=TESTER
AGENT_API_KEY=
MAX_UPLOAD_MB=50
LLM_PROVIDER=groq            # groq | gemini | openrouter | ollama | openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=                 # để trống = chế độ offline (không gọi LLM)
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
TASK_TIMEOUT_SECONDS=300
ARTIFACT_DIR=./artifacts
WORKSPACE_DIR=./workspace
DATA_DIR=./data
ALLOWED_COMMANDS=python,pytest
DRY_RUN=true
